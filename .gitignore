# Dependencies
node_modules/

# Build output
dist/
coverage/

# Runtime storage — everything is regenerated by `pnpm setup`;
# only the .gitkeep anchors that create the directory tree are committed
storage/*
!storage/.gitkeep
!storage/assets
storage/assets/*
!storage/assets/.gitkeep
!storage/templates
storage/templates/*
!storage/templates/.gitkeep
!storage/documents
storage/documents/*
!storage/documents/.gitkeep

# SQLite databases (dev + test artifacts)
*.db
*.db-journal
storage/test.db   # e2e suite database (see apps/api/test/setup-e2e.ts)

# Local env — created from the committed .env.example by `pnpm setup`
apps/api/.env

# Misc
.DS_Store
*.log
