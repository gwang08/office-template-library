// Prisma schema — SQLite, file resolved via DATABASE_URL (see apps/api/.env).
// Prisma v6 resolves relative `file:` URLs against this schema's directory,
// so `file:../../../storage/dev.db` points at the repo-root storage/dev.db.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// kind is "docx" | "pptx" — SQLite has no enforced enums, so it is a plain
// String here and validated with @IsIn in the DTOs (see phase-02).
model Template {
  id           String          @id @default(uuid())
  name         String
  description  String
  category     String
  kind         String
  storageKey   String          @unique
  thumbnailKey String
  createdAt    DateTime        @default(now())
  slides       TemplateSlide[]
  documents    Document[]
}

model TemplateSlide {
  id         String   @id @default(uuid())
  templateId String
  order      Int
  title      String
  previewKey String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model Document {
  id          String    @id @default(uuid())
  templateId  String
  kind        String
  title       String
  storageKey  String
  // Single source of truth for DOCX content (nullable until first edit)
  contentHtml String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  template    Template  @relation(fields: [templateId], references: [id])

  @@index([templateId])
}
